
[submodule "extern/ips2ra"]
	path = extern/ips2ra
	url = https://github.com/ips4o/ips2ra.git
[submodule "extern/tlx"]
	path = extern/tlx
	url = https://github.com/tlx/tlx.git
[submodule "extern/util"]
	path = extern/util
	url = https://github.com/ByteHamster/Util.git
[submodule "extern/leveldb"]
	path = extern/leveldb
	url = https://github.com/google/leveldb
[submodule "extern/pachash"]
	path = extern/pachash
	url = https://github.com/ByteHamster/PaCHash
[submodule "extern/rocksdb"]
	path = extern/rocksdb
	url = https://github.com/meta/rocksdb
	shallow = true
[submodule "extern/leanstore"]
	path = extern/leanstore
	url = https://github.com/leanstore/leanstore
	shallow = true
[submodule "extern/silt"]
	path = extern/silt
	url = https://github.com/ByteHamster/silt
